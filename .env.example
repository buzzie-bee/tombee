# SMTP configuration for contact form
# Default values work with the local MailHog instance:
#   docker compose up -d
#   Open http://localhost:8025 to see captured emails
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hello@tombee.io
CONTACT_EMAIL=hello@tombee.io
